# Server Configuration
PORT=5000
NODE_ENV=development

# Database Configuration (Docker local or MongoDB Atlas)
# Local Docker: mongodb://mongodb:27017/blogdb
# Local standalone: mongodb://127.0.0.1:27017/blogdb
# MongoDB Atlas: mongodb+srv://<username>:<password>@cluster0.mongodb.net/blogdb?retryWrites=true&w=majority
MONGO_URI=mongodb://127.0.0.1:27017/blogdb

# Client CORS Origin
CLIENT_ORIGIN=http://localhost:3000
